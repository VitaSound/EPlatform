# Runtime-only image when release is prebuilt (local mix release / CI artifact).
# Build context: server/ with _build/prod/rel/e_platform present.
ARG DEBIAN_VERSION=trixie-20260610-slim
FROM debian:${DEBIAN_VERSION}

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libstdc++6 openssl libncurses6 libtinfo6 locales ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8
ENV MIX_ENV=prod
ENV PHX_SERVER=true

WORKDIR /app
RUN chown nobody /app

COPY --chown=nobody:root _build/prod/rel/e_platform/ ./

USER nobody
CMD ["bin/e_platform", "start"]
